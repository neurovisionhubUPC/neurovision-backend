####
# Packages the Linux native executable produced from the repository root by:
# .\mvnw.cmd -pl analytics-service -am package "-Dnative" "-DskipTests" "-Dquarkus.native.container-build=true"
#
# Build this image from the analytics-service directory:
# docker build -f src/main/docker/Dockerfile.native-micro -t neurovision/analytics-service:native .
####
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0

WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
