# Generated local values belong in .env, which is ignored by Git.
COMPOSE_PROJECT_NAME=neurovision-rehab
NEUROVISION_IMAGE_TAG=compose-native

IAM_PORT=8081
PROFILE_PORT=8082
CLINICAL_PORT=8083
TELEMETRY_PORT=8084
KAFKA_PORT=9092

IAM_DB_PASSWORD=replace-with-a-random-local-value
PROFILE_DB_PASSWORD=replace-with-a-random-local-value
CLINICAL_DB_PASSWORD=replace-with-a-random-local-value
TELEMETRY_DB_PASSWORD=replace-with-a-random-local-value

AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-from-cloudformation
COGNITO_CLIENT_ID=replace-from-cloudformation
COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/replace-from-cloudformation

# Temporary credentials for the limited neurovision-iam-dev role.
# Prefer generating these with infra/docker/configure-local-env.ps1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Analytics Compose ports and local-only cursor signing key.
ANALYTICS_PORT=8085
ANALYTICS_MONGODB_PORT=27017
# Generate a private local value (at least 32 bytes); do not commit it.
ANALYTICS_GAZE_PLOT_CURSOR_SIGNING_KEY=
